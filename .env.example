# Copy to .env next to your compose file. Only needed if you want the admin API
# (see "Admin API" in the README); the web UI works without it.
#
# The web app presents this token to the scheduler; the scheduler only ever
# holds its hash, so no usable credential exists in the container that runs
# your task scripts. Generate a matching pair with:
#
#   TOKEN=$(openssl rand -base64 32)
#   echo "CRONULENT_SERVICE_TOKEN=$TOKEN"
#   echo "CRONULENT_SERVICE_TOKEN_HASH=$(printf %s "$TOKEN" | openssl dgst -sha256 -hex | awk '{print $2}')"
#
# Both containers must be restarted together after changing these.

CRONULENT_SERVICE_TOKEN=
CRONULENT_SERVICE_TOKEN_HASH=
